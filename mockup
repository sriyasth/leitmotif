function reducer(state, action) {
  switch (action.type) {
    case "SET_SCREEN": return { ...state, currentScreen: action.payload };
    case "SET_SESSION": return { ...state, session: { ...state.session, ...action.payload } };
    case "UPDATE_ENTITIES": return { ...state, entities: action.payload.entities, departedEntities: action.payload.departed || [] };
    case "SET_AUDIO": return { ...state, audioEngine: { ...state.audioEngine, ...action.payload } };
    case "SET_CONNECTIONS": return { ...state, connections: { ...state.connections, ...action.payload } };
    case "TOGGLE_DEMO": return { ...state, demoMode: !state.demoMode };
    case "SET_DEMO_TIME": return { ...state, demoTime: action.payload };
    case "ADD_CONTACT": return { ...state, contacts: { ...state.contacts, [action.payload.id]: action.payload } };
    case "SET_RECORDING": return { ...state, session: { ...state.session, recording: action.payload } };
    case "SET_RECORD_TIME": return { ...state, session: { ...state.session, recordTime: action.payload } };
    default: return state;
  }
}

