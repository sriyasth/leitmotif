// ============================================================
// MAIN APP
// ============================================================
export default function LeitmotifApp() {
  const [state, dispatch] = useReducer(reducer, initialState);
  const prevEntitiesRef = useRef({});

  // Demo mode tick
  useEffect(() => {
    if (!state.demoMode || !state.session.recording) return;
    let t = 0;
    const iv = setInterval(() => {
      t = (t + 0.5) % 30;
      dispatch({ type: "SET_DEMO_TIME", payload: t });
      const { entities, departed } = getDemoState(t);
      dispatch({ type: "UPDATE_ENTITIES", payload: { entities, departed } });
    }, 500);
    return () => clearInterval(iv);
  }, [state.demoMode, state.session.recording]);

  // Audio sync — play/update/depart entities
  useEffect(() => {
    if (!audioEngine.initialized) return;
    const prev = prevEntitiesRef.current;
    const curr = state.entities;

    // New or updated entities
    Object.values(curr).forEach(e => {
      const pos = e.position || {};
      audioEngine.playEntity(e.id, e.motifFreq || 440, pos.angle_deg || 0, pos.distance_m || 2);
    });

    // Departed
    state.departedEntities.forEach(id => {
      audioEngine.departEntity(id);
    });

    // Entities that disappeared without being in departed list
    Object.keys(prev).forEach(id => {
      if (!curr[id] && !state.departedEntities.includes(id)) {
        audioEngine.departEntity(id);
      }
    });

    prevEntitiesRef.current = curr;
  }, [state.entities, state.departedEntities]);

  const navigate = (screen) => dispatch({ type: "SET_SCREEN", payload: screen });

  const screens = {
    monitor: MonitorScreen,
    contacts: ContactsScreen,
    visualizer: VisualizerScreen,
    settings: SettingsScreen,
  };
  const Screen = screens[state.currentScreen];

  return (
    <AppContext.Provider value={{ state, dispatch }}>
      <div className="flex items-center justify-center min-h-screen bg-[#050508]">
        {/* Phone frame */}
        <div className="relative w-[390px] h-[844px] bg-[#0A0A0F] overflow-hidden shadow-2xl shadow-black/80 border border-slate-800/30 rounded-[2.5rem]">
          {/* Notch */}
          <div className="absolute top-0 left-1/2 -translate-x-1/2 w-36 h-7 bg-black rounded-b-2xl z-[60]" />

          <Screen />
          <BottomNav current={state.currentScreen} onNavigate={navigate} />
        </div>
      </div>
    </AppContext.Provider>
  );
}
