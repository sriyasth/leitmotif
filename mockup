function MonitorScreen() {
  const { state, dispatch } = useApp();
  const { videoRef, startCamera, stopCamera, captureFrame } = useCameraCapture(true);
  const [cameraActive, setCameraActive] = useState(false);
  const frameCountRef = useRef(0);
  const entities = state.entities;
  const entityList = Object.values(entities);
  const entityCount = entityList.length;

  // Toggle recording / camera
  const toggleRecording = async () => {
    if (!audioEngine.initialized) audioEngine.init();
    if (!state.session.recording) {
      await startCamera();
      if (state.demoMode) dispatch({ type: "TOGGLE_DEMO" });
      setCameraActive(true);
      dispatch({ type: "SET_RECORDING", payload: true });
      dispatch({ type: "SET_SESSION", payload: { status: "live" } });
    } else {
      stopCamera();
      setCameraActive(false);
      audioEngine.stopAll();
      dispatch({ type: "SET_RECORDING", payload: false });
      dispatch({ type: "SET_SESSION", payload: { status: "idle" } });
      dispatch({ type: "SET_RECORD_TIME", payload: 0 });
    }
  };

  // Record timer
  useEffect(() => {
    if (!state.session.recording) return;
    const iv = setInterval(() => dispatch({ type: "SET_RECORD_TIME", payload: state.session.recordTime + 1 }), 1000);
    return () => clearInterval(iv);
  }, [state.session.recording, state.session.recordTime]);

  // Frame sending (when camera active + not demo mode)
  useEffect(() => {
    if (!cameraActive || state.demoMode) return;
    const iv = setInterval(async () => {
      const frame = captureFrame();
      if (frame) {
        frameCountRef.current++;
        const result = await sendFrameToVision(state.session.id, frame, frameCountRef.current);
        if (result && result.entities) {
          const ents = {};
          result.entities.forEach(e => { ents[e.entity_id] = e; });
          dispatch({ type: "UPDATE_ENTITIES", payload: { entities: ents, departed: result.departed_entities } });
        }
      }
    }, 200); // 5 FPS
    return () => clearInterval(iv);
  }, [cameraActive, state.demoMode]);

  const formatTime = (s) => {
    const m = Math.floor(s / 60);
    const sec = s % 60;
    return `${String(m).padStart(2, "0")}:${String(sec).padStart(2, "0")}`;
  };

  const getEntityColor = (e) => e.color === "blue" || e.type === "known_person" ? "#00d4ff" : e.color === "amber" || e.type === "unknown_person" ? "#f59e0b" : "#9ca3af";

  return (
    <div className="absolute inset-0 bg-black">
      {/* Camera feed */}
      <video
        ref={videoRef}
        className={`absolute inset-0 w-full h-full object-cover ${cameraActive && !state.demoMode ? "" : "hidden"}`}
        autoPlay muted playsInline
      />

      {/* Placeholder shown when camera is off or in demo mode */}
      {(!cameraActive || state.demoMode) && (
        <div className="absolute inset-0 bg-gradient-to-br from-slate-900 via-[#0f1419] to-slate-900">
          <div className="absolute inset-0 opacity-20" style={{
            backgroundImage: `radial-gradient(circle at 30% 40%, rgba(0,212,255,0.08) 0%, transparent 50%),
                              radial-gradient(circle at 70% 60%, rgba(245,158,11,0.06) 0%, transparent 50%)`
          }} />
        </div>
      )}

      {/* Scanline overlay */}
      <div className="absolute inset-0 pointer-events-none opacity-10" style={{
        background: "repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,212,255,0.03) 2px, rgba(0,212,255,0.03) 4px)"
      }} />

      {/* Bounding Boxes */}
      {entityList.map(e => {
        const bb = e.boundingBox || {};
        const color = getEntityColor(e);
        return (
          <div key={e.id} className="absolute rounded-lg transition-all duration-500" style={{
            left: `${bb.x || 20}%`, top: `${bb.y || 30}%`, width: `${bb.w || 15}%`, height: `${bb.h || 30}%`,
            border: `2px solid ${color}`, backgroundColor: `${color}15`,
            opacity: e.state === "entering" ? 0.6 : e.state === "exiting" ? 0.3 : 0.8,
          }}>
            <div className="absolute -top-5 left-0 px-1.5 py-0.5 rounded-sm text-[9px] font-bold uppercase tracking-tight text-black"
              style={{ backgroundColor: color }}>
              {e.name || e.id}
            </div>
            {e.type !== "object" && (
              <div className="absolute -bottom-1 -right-1 w-3 h-3 rounded-full animate-pulse" style={{ backgroundColor: color, boxShadow: `0 0 8px ${color}` }} />
            )}
          </div>
        );
      })}

      {/* Top HUD */}
      <div className="absolute top-0 left-0 right-0 p-4 pt-10 bg-gradient-to-b from-black/80 to-transparent">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className={`flex items-center gap-1.5 px-2 py-1 rounded ${state.session.recording ? "bg-red-600/20 border border-red-600/50" : "bg-slate-800/60 border border-slate-700/50"}`}>
              {state.session.recording && <span className="size-2 rounded-full bg-red-600 animate-pulse" />}
              <span className="text-[10px] font-bold text-white tracking-widest uppercase">
                {state.session.recording ? "LIVE" : "STANDBY"}
              </span>
            </div>
            <span className="text-white/70 text-xs font-mono">Entities: {entityCount}</span>
            {entityCount >= state.audioEngine.crowdThreshold && (
              <span className="text-amber-400 text-[10px] font-bold uppercase animate-pulse">CROWD</span>
            )}
          </div>
          {state.demoMode && (
            <div className="px-2 py-1 rounded bg-amber-500/20 border border-amber-500/50">
              <span className="text-[10px] font-bold text-amber-400 tracking-widest">DEMO</span>
            </div>
          )}
        </div>
      </div>

      {/* Radar minimap */}
      <div className="absolute bottom-28 left-4 size-24 rounded-full bg-black/60 border border-[#00d4ff]/30 backdrop-blur-md overflow-hidden">
        {/* Pulse rings */}
        <div className="absolute inset-0 rounded-full border border-[#00d4ff]/20 animate-ping" style={{ animationDuration: "3s" }} />
        {/* Center */}
        <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 size-1.5 bg-[#00d4ff] rounded-full shadow-[0_0_8px_#00d4ff]" />
        {/* Entity dots */}
        {entityList.map(e => {
          const pos = e.position || {};
          const angle = ((pos.angle_deg || 0) - 90) * Math.PI / 180;
          const dist = Math.min((pos.distance_m || 2) / 6, 1);
          const x = 50 + Math.cos(angle) * dist * 40;
          const y = 50 + Math.sin(angle) * dist * 40;
          const color = getEntityColor(e);
          return (
            <div key={e.id} className="absolute size-2 rounded-full transition-all duration-500" style={{
              left: `${x}%`, top: `${y}%`, transform: "translate(-50%,-50%)",
              backgroundColor: color, boxShadow: `0 0 6px ${color}`,
            }} />
          );
        })}
      </div>

      {/* Center controls */}
      <div className="absolute bottom-36 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3">
        <button onClick={toggleRecording}
          className="size-20 rounded-full bg-white/10 backdrop-blur-xl border-4 border-white/20 flex items-center justify-center active:scale-95 transition-transform">
          {state.session.recording ? (
            <div className="size-8 rounded bg-red-600 shadow-[0_0_20px_rgba(220,38,38,0.6)]" />
          ) : (
            <div className="size-10 rounded-full bg-red-600 shadow-[0_0_20px_rgba(220,38,38,0.6)]" />
          )}
        </button>
        <span className="text-[10px] font-bold text-white/80 tracking-widest uppercase font-mono">
          {state.session.recording ? `REC ${formatTime(state.session.recordTime)}` : "TAP TO START"}
        </span>
      </div>

      {/* Right side buttons */}
      <div className="absolute bottom-28 right-4 flex flex-col gap-3">
        {[
          { icon: "volume_up", label: "Audio" },
          { icon: "photo_library", label: "Gallery" },
          { icon: "person", label: "Identify" },
        ].map(b => (
          <button key={b.icon} aria-label={b.label}
            className="size-11 rounded-full bg-black/60 backdrop-blur-md border border-white/10 flex items-center justify-center text-white/80 hover:text-white transition-colors">
            <Icon name={b.icon} className="text-xl" />
          </button>
        ))}
      </div>

      {/* Corner decorations */}
      <div className="absolute top-10 left-4 size-6 border-t-2 border-l-2 border-white/20 rounded-tl-lg pointer-events-none" />
      <div className="absolute top-10 right-4 size-6 border-t-2 border-r-2 border-white/20 rounded-tr-lg pointer-events-none" />
    </div>
  );
}

