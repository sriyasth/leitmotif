// SCREEN 3: SOUNDSCAPE VISUALIZER
// ============================================================
function VisualizerScreen() {
  const { state } = useApp();
  const canvasRef = useRef(null);
  const animRef = useRef(null);
  const entityList = Object.values(state.entities);
  const entitiesRef = useRef(entityList);
  entitiesRef.current = entityList;

  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    const W = 390, H = 600;
    canvas.width = W;
    canvas.height = H;
    const cx = W / 2, cy = H / 2;

    let t = 0;
    const animate = () => {
      t += 0.02;
      ctx.fillStyle = "#0A0A0F";
      ctx.fillRect(0, 0, W, H);

      // Concentric rings
      for (let i = 1; i <= 5; i++) {
        const r = i * 55;
        const pulse = Math.sin(t * 0.5 + i * 0.3) * 3;
        ctx.beginPath();
        ctx.arc(cx, cy, r + pulse, 0, Math.PI * 2);
        ctx.strokeStyle = `rgba(236, 91, 19, ${0.12 - i * 0.015})`;
        ctx.lineWidth = 1;
        ctx.stroke();
      }

      // Center hub
      const hubPulse = 8 + Math.sin(t * 2) * 2;
      const gradient = ctx.createRadialGradient(cx, cy, 0, cx, cy, hubPulse * 2);
      gradient.addColorStop(0, "rgba(236, 91, 19, 0.8)");
      gradient.addColorStop(0.5, "rgba(236, 91, 19, 0.2)");
      gradient.addColorStop(1, "transparent");
      ctx.fillStyle = gradient;
      ctx.beginPath();
      ctx.arc(cx, cy, hubPulse * 2, 0, Math.PI * 2);
      ctx.fill();
      ctx.beginPath();
      ctx.arc(cx, cy, hubPulse, 0, Math.PI * 2);
      ctx.fillStyle = "#ec5b13";
      ctx.fill();

      // Entity orbs
      const ents = entitiesRef.current;
      ents.forEach(e => {
        const pos = e.position || {};
        const angle = ((pos.angle_deg || 0) - 90) * Math.PI / 180;
        const dist = Math.min((pos.distance_m || 2) / 6, 1);
        const radius = dist * 220;
        const ex = cx + Math.cos(angle) * radius;
        const ey = cy + Math.sin(angle) * radius;

        const isKnown = e.type === "known_person" || e.color === "blue";
        const isObject = e.type === "object" || e.color === "gray";
        const baseColor = isKnown ? [59, 130, 246] : isObject ? [156, 163, 175] : [245, 158, 11];
        const orbSize = isObject ? 5 : 8;

        // Breathing pulse
        const breath = orbSize + Math.sin(t * 3 + (e.motifFreq || 440) * 0.01) * 2;

        // Glow
        const glow = ctx.createRadialGradient(ex, ey, 0, ex, ey, breath * 3);
        glow.addColorStop(0, `rgba(${baseColor.join(",")}, 0.6)`);
        glow.addColorStop(0.5, `rgba(${baseColor.join(",")}, 0.15)`);
        glow.addColorStop(1, "transparent");
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(ex, ey, breath * 3, 0, Math.PI * 2);
        ctx.fill();

        // Orb
        ctx.beginPath();
        ctx.arc(ex, ey, breath, 0, Math.PI * 2);
        ctx.fillStyle = `rgb(${baseColor.join(",")})`;
        ctx.fill();
        ctx.strokeStyle = "rgba(255,255,255,0.8)";
        ctx.lineWidth = 1.5;
        ctx.stroke();

        // Label
        const name = e.name || "Unknown";
        ctx.font = "bold 10px 'Public Sans', sans-serif";
        ctx.textAlign = "center";
        ctx.fillStyle = `rgba(${baseColor.join(",")}, 0.9)`;
        const labelW = ctx.measureText(name).width + 16;
        const ly = ey + breath + 16;
        ctx.fillStyle = `rgba(${baseColor[0]}, ${baseColor[1]}, ${baseColor[2]}, 0.15)`;
        roundRect(ctx, ex - labelW / 2, ly - 8, labelW, 16, 8);
        ctx.fill();
        ctx.strokeStyle = `rgba(${baseColor.join(",")}, 0.3)`;
        ctx.lineWidth = 0.5;
        ctx.stroke();
        ctx.fillStyle = `rgba(${baseColor.join(",")}, 0.9)`;
        ctx.fillText(name, ex, ly + 3);
      });

      animRef.current = requestAnimationFrame(animate);
    };

    animate();
    return () => cancelAnimationFrame(animRef.current);
  }, []);

  return (
    <div className="absolute inset-0 bg-[#0A0A0F] flex flex-col">
      {/* Header */}
      <div className="absolute top-0 w-full z-20 flex items-center justify-between p-6 pt-10 bg-gradient-to-b from-[#0A0A0F] to-transparent">
        <div className="size-10" />
        <div className="text-center">
          <h2 className="text-white text-sm font-bold tracking-widest uppercase">Live Soundscape</h2>
          <p className="text-slate-400 text-[10px] font-medium">{entityList.length} ENTITIES ACTIVE</p>
        </div>
        <div className="size-10" />
      </div>

      {/* Canvas */}
      <div className="flex-1 flex items-center justify-center pt-16 pb-28">
        <canvas ref={canvasRef} className="w-[390px] h-[600px]" />
      </div>

      {/* Footer stats */}
      <div className="absolute bottom-36 left-0 w-full px-6 flex justify-between items-end z-20">
        <div className="space-y-1">
          <p className="text-slate-500 text-[10px] uppercase font-bold tracking-widest">Environment Noise</p>
          <div className="flex items-center gap-2">
            <div className="flex gap-0.5 h-6 items-end">
              {[2, 4, 3, 6, 2].map((h, i) => (
                <div key={i} className="w-1 bg-[#ec5b13] rounded-full" style={{ height: `${h * 4}px` }} />
              ))}
            </div>
            <span className="text-2xl font-bold text-white">42<span className="text-xs text-slate-400 ml-0.5 font-normal">dB</span></span>
          </div>
        </div>
        <div className="bg-slate-900/80 backdrop-blur-xl border border-slate-700/50 rounded-xl p-3 flex items-center gap-3">
          <div className="size-2 rounded-full bg-green-500" />
          <p className="text-xs font-semibold text-slate-200">System calibrated</p>
        </div>
      </div>
    </div>
  );
}

function roundRect(ctx, x, y, w, h, r) {
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y);
  ctx.quadraticCurveTo(x + w, y, x + w, y + r);
  ctx.lineTo(x + w, y + h - r);
  ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
  ctx.lineTo(x + r, y + h);
  ctx.quadraticCurveTo(x, y + h, x, y + h - r);
  ctx.lineTo(x, y + r);
  ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();
}

