// API SERVICES (Integration Layer)
// ============================================================
const API_CONFIG = {
  visionBaseUrl: "http://localhost:8001",
  audioBaseUrl: "http://localhost:8002",
  wsUrl: "ws://localhost:8001/ws/session",
};

async function sendFrameToVision(sessionId, frame, frameIndex) {
  try {
    const res = await fetch(`${API_CONFIG.visionBaseUrl}/api/vision/frames`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ session_id: sessionId, timestamp: Date.now(), frame, frame_index: frameIndex }),
    });
    return await res.json();
  } catch (e) {
    return null; // Fall back to demo mode
  }
}

async function requestMotifGeneration(entityId, description) {
  try {
    const res = await fetch(`${API_CONFIG.audioBaseUrl}/api/audio/generate`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ entity_id: entityId, leitmotif_description: description, duration_sec: 4, loopable: true }),
    });
    return await res.json();
  } catch (e) {
    return null;
  }
}

