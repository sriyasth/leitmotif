// ============================================================
// AUDIO ENGINE (Web Audio API)x
// ============================================================
class SpatialAudioEngine {
  constructor() {
    this.ctx = null;
    this.masterGain = null;
    this.sources = {};
    this.initialized = false;
  }

  init() {
    if (this.initialized) return;
    this.ctx = new (window.AudioContext || window.webkitAudioContext)();
    this.masterGain = this.ctx.createGain();
    this.masterGain.connect(this.ctx.destination);
    this.masterGain.gain.value = 0.82;
    this.initialized = true;
  }

  setMasterVolume(v) {
    if (this.masterGain) this.masterGain.gain.setTargetAtTime(v, this.ctx.currentTime, 0.1);
  }

  playEntity(entityId, freq, angleDeg, distanceM) {
    if (!this.initialized) this.init();
    if (this.sources[entityId]) return this.updateEntity(entityId, angleDeg, distanceM);

    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();
    const panner = this.ctx.createStereoPanner();

    // Unique tone: base freq + harmonics
    osc.type = "sine";
    osc.frequency.value = freq;

    // Spatial panning from angle (-90 to 90 -> -1 to 1)
    panner.pan.value = Math.max(-1, Math.min(1, angleDeg / 90));

    // Distance attenuation
    const distGain = Math.max(0.05, 1 / (1 + distanceM * 0.5));
    gain.gain.value = 0;

    osc.connect(gain);
    gain.connect(panner);
    panner.connect(this.masterGain);
    osc.start();

    // Fade in over 500ms
    gain.gain.setTargetAtTime(distGain, this.ctx.currentTime, 0.15);

    this.sources[entityId] = { osc, gain, panner, freq };
  }

  updateEntity(entityId, angleDeg, distanceM) {
    const src = this.sources[entityId];
    if (!src) return;
    src.panner.pan.setTargetAtTime(Math.max(-1, Math.min(1, angleDeg / 90)), this.ctx.currentTime, 0.1);
    const distGain = Math.max(0.05, 1 / (1 + distanceM * 0.5));
    src.gain.gain.setTargetAtTime(distGain, this.ctx.currentTime, 0.1);
  }

  departEntity(entityId) {
    const src = this.sources[entityId];
    if (!src) return;
    // Pitch shift down + fade out for departure
    src.osc.frequency.setTargetAtTime(src.freq * 0.7, this.ctx.currentTime, 0.3);
    src.gain.gain.setTargetAtTime(0, this.ctx.currentTime, 0.4);
    setTimeout(() => {
      try { src.osc.stop(); } catch (e) {}
      delete this.sources[entityId];
    }, 1500);
  }

  stopAll() {
    Object.keys(this.sources).forEach(id => {
      try { this.sources[id].osc.stop(); } catch (e) {}
    });
    this.sources = {};
  }

  playPreview(freq) {
    if (!this.initialized) this.init();
    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();
    osc.type = "sine";
    osc.frequency.value = freq;
    gain.gain.value = 0.3;
    osc.connect(gain);
    gain.connect(this.masterGain);
    osc.start();
    gain.gain.setTargetAtTime(0, this.ctx.currentTime + 1.5, 0.3);
    setTimeout(() => { try { osc.stop(); } catch(e){} }, 2500);
  }
}

